# Environment variables for production deployment

# Resend API key for sending contact form emails
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_EMAIL=ferdinandderosaputra1@gmail.com

# Upstash Redis — durable rate limiting for the contact form.
# Without these, the limiter falls back to per-instance memory, which on
# serverless only limits a single warm instance.
# Console → your database → REST API: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Custom site URL (overrides auto-detection)
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
